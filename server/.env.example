# サーバーのポート番号
PORT=3000

# Googleスプレッドシート（簡易DB）
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 秘密鍵は改行を \n のまま1行の文字列として貼り付けてください
GOOGLE_PRIVATE_KEY=

# Web版のプッシュ通知(Web Push)用の鍵ペア。
# node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))" で生成してください
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
